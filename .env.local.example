# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Your API key for whichever endpoint you point OPENAI_BASE_URL at.
# Without it, Generate reports a clear "set your API key" error instead of
# crashing.
OPENAI_API_KEY=sk-...

# Optional. Defaults shown. Point this at another /chat/completions endpoint if
# you have one. Strict structured outputs (response_format: json_schema with
# strict: true) are tried first; endpoints that reject schema mode (DeepSeek
# does) are retried automatically in plain JSON mode, with the schema embedded
# in the prompt and the reply re-validated here. See the README.
#
# DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash     # or deepseek-v4-pro
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Optional. Where projects live. Default: ./projects
# Each project is a folder holding input.txt, script.json, scenes.json,
# clips/*.mp4, preview.mp4 and out.mp4.
PROJECTS_DIR=./projects
