# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Your API key for whichever endpoint you point OPENAI_BASE_URL at.
# Without it, Generate reports a clear "set your API key" error instead of
# crashing.
OPENAI_API_KEY=sk-...

# Optional. Defaults shown. Point this at another /chat/completions endpoint if
# you have one. Strict structured outputs (response_format: json_schema with
# strict: true) are tried first; endpoints that reject schema mode (DeepSeek
# does) are retried automatically in plain JSON mode, with the schema embedded
# in the prompt and the reply re-validated here. See the README.
#
# DeepSeek (the code's defaults):
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash     # or deepseek-v4-pro
# Or an OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-terra

# Thinking mode for the storyboard call: on makes v4-flash comply with the
# scene rules; off is faster and cheaper but under-produces short storyboards.
LLM_THINKING_MODE=true

# Optional. Where projects live. Default: ./projects
# Each project is a folder holding input.txt, script.json, scenes.json,
# clips/*.mp4, preview.mp4 and out.mp4.
PROJECTS_DIR=./projects

# Optional. The voice the render worker narrates with, and the directory the
# Kokoro model is cached in. Defaults shown. The voice must be one kokoro-js
# bundles (af_heart, af_bella, am_michael, bf_emma, ...); the ~90 MB quantized
# model downloads into the directory on the first narration, so that first
# render needs network the way the font download already does. A relative
# directory resolves against the repo root, not the working directory.
#
# Read by the render *worker*, not by the Next server: the app passes its own
# environment on to the worker it spawns, so the app's renders see these, but a
# render you start from your terminal needs them exported in that shell.
# KOKORO_VOICE=af_heart
# KOKORO_MODELS_DIR=./models

# Optional. Where JSON app logs (LLM requests/responses, generate and pipeline
# events) are appended. Default: ./logs/app.log
# LOG_FILE=./logs/app.log
